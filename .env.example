# Database connection string
DATABASE_URL=mongodb://127.0.0.1/your-database-name

# Or use a PG connection string
#DATABASE_URL=postgresql://127.0.0.1:5432/your-database-name

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Browser key for the booking form's Google Places court autocomplete.
# Enable Maps JavaScript API + Places API (New), then restrict the key to your site origins.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_browser_restricted_google_maps_key

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# Transactional booking emails via Resend. The sender must use a verified Resend domain.
RESEND_API_KEY=re_your_api_key
RESEND_FROM_NAME=Next Shot Badminton
RESEND_FROM_ADDRESS=bookings@your-domain.com

# Optional fallback when the assigned coach does not have an email in Payload.
COACH_NOTIFICATION_EMAIL=coach@your-domain.com

GOOGLE_CLIENT_ID=123456789-example.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback